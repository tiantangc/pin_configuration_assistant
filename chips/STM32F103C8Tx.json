  "reserved_pins_by_default": ["PA13", "PA14", "PB2", "PD0", "PD1"],
  "penalty_pins": {
    "PB3": "JTDO，需关闭 JTAG 才能用",
    "PB4": "NJTRST，需关闭 JTAG 才能用",
    "PA15": "JTDI，需关闭 JTAG 才能用",
    "PC13": "TAMPER-RTC，驱动能力弱",
    "PC14": "OSC32_IN，不用 LSE 才可用",
    "PC15": "OSC32_OUT，不用 LSE 才可用",
