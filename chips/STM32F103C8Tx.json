      ]
    },
    "TIMER": {
      "TIM1": [
        {"remap": 0, "label": "TIM1 默认", "channels": {"1": "PA8", "2": "PA9", "3": "PA10", "4": "PA11"}}
      ],
      "TIM2": [
        {"remap": 0, "label": "TIM2 默认", "channels": {"1": "PA0", "2": "PA1", "3": "PA2", "4": "PA3"}},
        {"remap": 1, "label": "TIM2 部分重映射1", "channels": {"1": "PA15", "2": "PB3", "3": "PA2", "4": "PA3"}},
        {"remap": 2, "label": "TIM2 部分重映射2", "channels": {"1": "PA0", "2": "PA1", "3": "PB10", "4": "PB11"}},
        {"remap": 3, "label": "TIM2 完全重映射", "channels": {"1": "PA15", "2": "PB3", "3": "PB10", "4": "PB11"}}
      ],
      "TIM3": [
        {"remap": 0, "label": "TIM3 默认", "channels": {"1": "PA6", "2": "PA7", "3": "PB0", "4": "PB1"}},
        {"remap": 1, "label": "TIM3 部分重映射", "channels": {"1": "PB4", "2": "PB5", "3": "PB0", "4": "PB1"}}
      ],
      "TIM4": [
        {"remap": 0, "label": "TIM4 默认", "channels": {"1": "PB6", "2": "PB7", "3": "PB8", "4": "PB9"}}
